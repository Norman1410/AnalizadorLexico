import java_cup.runtime.*;
import ast.*;
import java.util.*;

/*  Código del Parser  */
parser code {:
    public void syntax_error(Symbol cur_token) {
        System.err.println("Error sintáctico en línea " + cur_token.left + ", columna " + cur_token.right);
        System.err.println("Token no esperado: " + sym.terminalNames[cur_token.sym] + 
            (cur_token.value != null ? " (" + cur_token.value + ")" : ""));
    }

    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        System.err.println("Error fatal: No se pudo recuperar del error sintáctico.");
    }
:};

/*  Declaraciones de Terminales  */
terminal WORLD, LOCAL, ENDL;
terminal PLUS, MINUS, TIMES, DIV, IDIV, MOD, POW, INC, DEC;
terminal LT, LE, GT, GE, EQ, NE;
terminal AND, OR, NOT;
terminal DECIDE, OF, ELSE, END;
terminal LOOP, EXIT, WHEN, FOR;
terminal RETURN, BREAK;
terminal SHOW, GET;
terminal GIFT, NAVIDAD, COAL;

/* Tipos */
terminal INT, FLOAT, CHAR, STRING, BOOLEAN; 
terminal COMMA, SEMICOLON, LBRACKET, RBRACKET, LCURLY, RCURLY, ASSIGN;

terminal LPAR, RPAR;      /* ¿ y ? */
terminal LBRACE, RBRACE;  /* ¡ y ! */
terminal ARROW;           /* -> */

terminal String IDENT;
terminal Object INT_LIT;
terminal Object FLOAT_LIT;
terminal Object BOOL_LIT;
terminal String STRING_LIT;
terminal String CHAR_LIT;
terminal ERROR, UMINUS, TO;

/*  No terminales  */
non terminal ProgramNode program;
non terminal List<ASTNode> decl_list;
non terminal ASTNode decl_global;
non terminal MainNode main_nav;
non terminal BlockNode bloque;
non terminal List<ASTNode> sentencias;
non terminal List<ASTNode> sentencia_list;
non terminal ASTNode sentencia;
non terminal List<ParamNode> params;
non terminal ASTNode expr, literal, io, asign, decl;
non terminal ASTNode decide_stmt, loop_stmt, for_stmt;
non terminal List<ASTNode> casos;
non terminal ASTNode cason, else_opt;
non terminal List<ASTNode> funciones_list;
non terminal FunctionNode funcion;
non terminal List<ParamNode> lista_params;
non terminal CallNode llamada;
non terminal List<ASTNode> lista_expr;
non terminal String tipo;
non terminal ParamNode param;

/*  Precedencia y Asociatividad  */
precedence left OR;
precedence left AND;
precedence right NOT;
precedence left LT, LE, GT, GE, EQ, NE;
precedence left PLUS, MINUS;
precedence left TIMES, DIV, IDIV, MOD;
precedence right POW;
precedence right INC, DEC, UMINUS;
precedence left LPAR;

/*  Start  */
start with program;

/*  Producciones  */
program ::= decl_list:dl funciones_list:fl main_nav:m
          {: RESULT = new ProgramNode(dl, fl, m, dlleft, dlright); :}
          ;

decl_list ::= /* empty */
            {: RESULT = new ArrayList<ASTNode>(); :}
            | decl_list:dl decl_global:dg
            {: if(dg != null) dl.add(dg); RESULT = dl; :}
            ;

funciones_list ::= /* empty */
                 {: RESULT = new ArrayList<ASTNode>(); :}
                 | funciones_list:fl funcion:f
                 {: if(f != null) fl.add(f); RESULT = fl; :}
                 ;

tipo ::= INT {: RESULT = "int"; :}
       | FLOAT {: RESULT = "float"; :}
       | CHAR {: RESULT = "char"; :}
       | STRING {: RESULT = "string"; :}
       | BOOLEAN {: RESULT = "boolean"; :}
       ;

decl_global ::= WORLD tipo:t IDENT:id ENDL
                {: RESULT = new DeclNode(id, null, true, t, new ArrayList<>(), idleft, idright); :}
              | WORLD tipo:t IDENT:id ARROW expr:e ENDL
                {: RESULT = new DeclNode(id, e, true, t, new ArrayList<>(), idleft, idright); :}
              | WORLD tipo:t IDENT:id ASSIGN expr:e ENDL
                {: RESULT = new DeclNode(id, e, true, t, new ArrayList<>(), idleft, idright); :}
              ;

funcion ::= GIFT tipo:t IDENT:id params:p bloque:b
            {: RESULT = new FunctionNode(id, t, p, b, idleft, idright); :}
          ;

main_nav ::= NAVIDAD params:p bloque:b
         {: RESULT = new MainNode(b, false, pleft, pright); :}
       | COAL NAVIDAD params:p bloque:b
         {: RESULT = new MainNode(b, true, pleft, pright); :}
       ;

params ::= LPAR RPAR
           {: RESULT = new ArrayList<ParamNode>(); :}
         | LPAR lista_params:l RPAR
           {: RESULT = l; :}
         ;

lista_params ::= param:p
                 {: List<ParamNode> l = new ArrayList<ParamNode>(); l.add(p); RESULT = l; :}
               | lista_params:l COMMA param:p
                 {: l.add(p); RESULT = l; :}
               | lista_params:l param:p
                 {: l.add(p); RESULT = l; :}
               ;

param ::= tipo:t IDENT:id
          {: RESULT = new ParamNode(id, t, idleft, idright); :}
        ;

bloque ::= LBRACE sentencias:s RBRACE
           {: RESULT = new BlockNode(s, sleft, sright); :}
         ;

sentencias ::= /* empty */
               {: RESULT = new ArrayList<ASTNode>(); :}
             | sentencia_list:sl
               {: RESULT = sl; :}
             ;

sentencia_list ::= sentencia:s
                   {: List<ASTNode> sl = new ArrayList<ASTNode>(); sl.add(s); RESULT = sl; :}
                 | sentencia_list:sl sentencia:s
                   {: if(s != null) sl.add(s); RESULT = sl; :}
                 ;

sentencia ::= io:i {: RESULT = i; :}
             | asign:a {: RESULT = a; :}
             | decl:d {: RESULT = d; :}
             | decide_stmt:ds {: RESULT = ds; :}
             | loop_stmt:ls {: RESULT = ls; :}
             | for_stmt:fs {: RESULT = fs; :}
             | BREAK:b ENDL {: RESULT = new BreakNode(bleft, bright); :}
             | RETURN:r ENDL {: RESULT = new ReturnNode(null, rleft, rright); :}
             | RETURN:r expr:e ENDL {: RESULT = new ReturnNode(e, rleft, rright); :}
             | expr:e ENDL {: RESULT = e; :}
             | error ENDL {: RESULT = null; :}
             ;

decl ::= LOCAL tipo:t IDENT:id ENDL
         {: RESULT = new DeclNode(id, null, false, t, new ArrayList<>(), idleft, idright); :}
       | LOCAL tipo:t IDENT:id ARROW expr:e ENDL
         {: RESULT = new DeclNode(id, e, false, t, new ArrayList<>(), idleft, idright); :}
       | LOCAL tipo:t IDENT:id ASSIGN expr:e ENDL
         {: RESULT = new DeclNode(id, e, false, t, new ArrayList<>(), idleft, idright); :}
       /* Soporte arreglos */
       | LOCAL tipo:t IDENT:id LBRACKET INT_LIT:sz1 RBRACKET LBRACKET INT_LIT:sz2 RBRACKET ENDL
         {: 
            List<Integer> dims = new ArrayList<>(); 
            dims.add(Integer.parseInt(sz1.toString())); 
            dims.add(Integer.parseInt(sz2.toString()));
            RESULT = new DeclNode(id, null, false, t, dims, idleft, idright); 
         :}
       | LOCAL tipo:t IDENT:id LBRACKET INT_LIT:sz1 RBRACKET LBRACKET INT_LIT:sz2 RBRACKET ASSIGN expr:e ENDL
         {: 
            List<Integer> dims = new ArrayList<>(); 
            dims.add(Integer.parseInt(sz1.toString())); 
            dims.add(Integer.parseInt(sz2.toString()));
            RESULT = new DeclNode(id, e, false, t, dims, idleft, idright); 
         :}
       /* Para for */
       | tipo:t IDENT:id ASSIGN expr:e
         {: RESULT = new DeclNode(id, e, false, t, new ArrayList<>(), idleft, idright); :}
       ;

decide_stmt ::= DECIDE OF casos:c else_opt:el END DECIDE ENDL
                {: RESULT = new DecideNode(null, c, el, cleft, cright); :}
              | DECIDE OF casos:c else_opt:el END DECIDE
                {: RESULT = new DecideNode(null, c, el, cleft, cright); :}
              ;

casos ::= /* empty */
          {: RESULT = new ArrayList<ASTNode>(); :}
        | casos:cl cason:cn
          {: if(cn != null) cl.add(cn); RESULT = cl; :}
        ;

cason ::= expr:e ARROW bloque:b
          {: RESULT = new CaseNode(e, b, eleft, eright); :}
        | expr:e ARROW sentencia:s 
          {: List<ASTNode> sl = new ArrayList<>(); sl.add(s); RESULT = new CaseNode(e, new BlockNode(sl, sleft, sright), eleft, eright); :}
        ;

else_opt ::= /* empty */
             {: RESULT = null; :}
           | ELSE ARROW bloque:b
             {: RESULT = b; :}
           | ELSE ARROW sentencia:s
             {: List<ASTNode> sl = new ArrayList<>(); sl.add(s); RESULT = new BlockNode(sl, sleft, sright); :}
           | ELSE bloque:b
             {: RESULT = b; :}
           ;

loop_stmt ::= LOOP sentencias:s EXIT WHEN expr:e ENDL END LOOP ENDL
              {: RESULT = new LoopNode(new BlockNode(s, sleft, sright), e, sleft, sright); :}
            ;

for_stmt ::= FOR LPAR decl:d ENDL expr:cond ENDL expr:step RPAR bloque:b
             {: RESULT = new ForNode(d, cond, step, b, dleft, dright); :}
           | FOR IDENT:id ARROW expr:start TO expr:end bloque:b ENDL
             {: RESULT = new ForNode(new VariableNode(id, idleft, idright), start, end, b, idleft, idright); :}
           | FOR LPAR decl:d expr:cond ENDL expr:step RPAR bloque:b
             {: RESULT = new ForNode(d, cond, step, b, dleft, dright); :}
           ;

io ::= SHOW expr:e ENDL
       {: RESULT = new ShowNode(e, eleft, eright); :}
     | SHOW expr:e
       {: RESULT = new ShowNode(e, eleft, eright); :}
     | GET IDENT:id ENDL
       {: RESULT = new GetNode(new VariableNode(id, idleft, idright), idleft, idright); :}
     ;

asign ::= IDENT:id ARROW expr:e ENDL
           {: RESULT = new AssignNode(new VariableNode(id, idleft, idright), e, idleft, idright); :}
         | IDENT:id ASSIGN expr:e ENDL
           {: RESULT = new AssignNode(new VariableNode(id, idleft, idright), e, idleft, idright); :}
         | IDENT:id ASSIGN expr:e
           {: RESULT = new AssignNode(new VariableNode(id, idleft, idright), e, idleft, idright); :}
         ;

expr ::= IDENT:id {: RESULT = new VariableNode(id, idleft, idright); :}
       | literal:l {: RESULT = l; :}
       | expr:e1 PLUS  expr:e2 {: RESULT = new BinaryNode(e1, "+", e2, e1left, e1right); :}
       | expr:e1 MINUS expr:e2 {: RESULT = new BinaryNode(e1, "-", e2, e1left, e1right); :}
       | expr:e1 TIMES expr:e2 {: RESULT = new BinaryNode(e1, "*", e2, e1left, e1right); :}
       | expr:e1 DIV   expr:e2 {: RESULT = new BinaryNode(e1, "/", e2, e1left, e1right); :}
       | expr:e1 IDIV  expr:e2 {: RESULT = new BinaryNode(e1, "//", e2, e1left, e1right); :}
       | expr:e1 MOD   expr:e2 {: RESULT = new BinaryNode(e1, "%", e2, e1left, e1right); :}
       | expr:e1 POW   expr:e2 {: RESULT = new BinaryNode(e1, "^", e2, e1left, e1right); :}
       | MINUS:m expr:e {: RESULT = new UnaryNode("-", e, true, mleft, mright); :} %prec UMINUS
       | INC:i IDENT:id {: RESULT = new UnaryNode("++", new VariableNode(id, idleft, idright), true, ileft, iright); :}
       | DEC:d IDENT:id {: RESULT = new UnaryNode("--", new VariableNode(id, idleft, idright), true, dleft, dright); :}
       | expr:e1 LT expr:e2 {: RESULT = new BinaryNode(e1, "<", e2, e1left, e1right); :}
       | expr:e1 LE expr:e2 {: RESULT = new BinaryNode(e1, "<=", e2, e1left, e1right); :}
       | expr:e1 GT expr:e2 {: RESULT = new BinaryNode(e1, ">", e2, e1left, e1right); :}
       | expr:e1 GE expr:e2 {: RESULT = new BinaryNode(e1, ">=", e2, e1left, e1right); :}
       | expr:e1 EQ expr:e2 {: RESULT = new BinaryNode(e1, "==", e2, e1left, e1right); :}
       | expr:e1 NE expr:e2 {: RESULT = new BinaryNode(e1, "!=", e2, e1left, e1right); :}
       | expr:e1 AND expr:e2 {: RESULT = new BinaryNode(e1, "&&", e2, e1left, e1right); :}
       | expr:e1 OR  expr:e2 {: RESULT = new BinaryNode(e1, "||", e2, e1left, e1right); :}
       | NOT:n expr:e {: RESULT = new UnaryNode("!", e, true, nleft, nright); :}
       | LPAR expr:e RPAR {: RESULT = e; :}
       | llamada:ll {: RESULT = ll; :}
       | LBRACE lista_expr:l RBRACE {: RESULT = new ArrayLiteralNode(l, lleft, lright); :}
       ;

llamada ::= IDENT:id LPAR RPAR
            {: RESULT = new CallNode(id, new ArrayList<ASTNode>(), idleft, idright); :}
          | IDENT:id LPAR lista_expr:l RPAR
            {: RESULT = new CallNode(id, l, idleft, idright); :}
          ;

lista_expr ::= expr:e
                {: List<ASTNode> l = new ArrayList<ASTNode>(); l.add(e); RESULT = l; :}
              | lista_expr:l COMMA expr:e
                {: l.add(e); RESULT = l; :}
              | lista_expr:l expr:e
                {: l.add(e); RESULT = l; :}
              ;

literal ::= INT_LIT:n {: RESULT = new LiteralNode(n, "int", nleft, nright); :}
          | FLOAT_LIT:f {: RESULT = new LiteralNode(f, "float", fleft, fright); :}
          | STRING_LIT:s {: RESULT = new LiteralNode(s, "string", sleft, sright); :}
          | BOOL_LIT:b {: RESULT = new LiteralNode(b, "bool", bleft, bright); :}
          | CHAR_LIT:c {: RESULT = new LiteralNode(c, "char", cleft, cright); :}
          ;
